# Database Configuration
# Local: postgresql://studentadmin:studentpass123@localhost:5432/student_tracker
# Render production: paste your Neon pooled connection string (see render.yaml)
DATABASE_URL=postgresql://studentadmin:studentpass123@localhost:5432/student_tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# JWT Security
SECRET_KEY=your-secret-key-here-change-in-production-must-be-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=Student Academic Tracker
DEBUG=false
ENVIRONMENT=development

# CORS - Comma-separated list
# Local: http://localhost:3000,http://localhost:5173
# Render production: ["https://sata-frontend.onrender.com"]
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Groq LLM (AI Interview Question Generation)
# ---------------------------------------------------------------------------
# Get a free API key at: https://console.groq.com
# Without this key the interview falls back to the built-in question bank.
GROQ_API_KEY=

# Optional tuning (defaults shown — change only if needed)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SEC=10.0

# JSearch API Key
RAPIDAPI_KEY=""
