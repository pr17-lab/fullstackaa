# =============================================================================
# .env.example — Copy to backend/.env and fill in real values.
#
# This file is SAFE to commit — it contains no real secrets.
# backend/.env is git-ignored and contains actual secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Local Docker Compose:
#   Uses the "postgres" Docker service — compose overrides this automatically.
#   DATABASE_URL=postgresql://studentadmin:studentpass123@postgres:5432/student_tracker
#
# Render Production (set DATABASE_URL in Render dashboard — marked sync:false in render.yaml):
#   Paste your Neon pooled connection string. Format:
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://studentadmin:studentpass123@localhost:5432/student_tracker

# Connection pool settings (defaults shown; tune for your plan's connection limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# SECURITY — JWT
# -----------------------------------------------------------------------------
# MUST be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=Student Academic Tracker
DEBUG=false
# Options: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# CORS — comma-separated allowed origins
# Local dev: include both Vite ports
# Production (Render): set to your frontend's onrender.com URL
# Example: CORS_ORIGINS=["https://sata-frontend.onrender.com"]
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# GROQ LLM — AI Interview Question Generation
# Get a free key at: https://console.groq.com
# Without this, the interview module falls back to the built-in question bank.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SEC=10.0

# -----------------------------------------------------------------------------
# GOOGLE GEMINI — Roadmap generation
# Get a key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# RAPID API — Job listings (JSearch)
# Get a key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=
